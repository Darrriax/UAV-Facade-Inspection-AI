# Copy to `.env.local` and adjust if needed.
#
# Left empty on purpose: the default is `/api/v1`, which the Vite dev server
# proxies to http://localhost:8000 (see vite.config.ts) and which a reverse
# proxy serves in production. Only set this when the API is on another origin,
# e.g. VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=

# NodeODM, for the reconstructions the 3D page runs in the browser. Left empty on
# purpose: the default is http://localhost:3000, the port compose publishes.
VITE_NODEODM_URL=
