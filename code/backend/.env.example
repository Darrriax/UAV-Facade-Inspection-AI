# Copy to the repository root as `.env` (docker compose reads it) or to
# code/backend/.env when running the app directly with uvicorn.
#   cp code/backend/.env.example .env
# Do not commit real credentials.

# ---------------------------------------------------------------- application
ENVIRONMENT=development
DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------ PostgreSQL
POSTGRES_USER=facade
POSTGRES_PASSWORD=facade
POSTGRES_DB=facade
# Host/port inside the compose network are injected by docker-compose.yml.
# The port below is the one a host-run process should dial, i.e. the *published*
# side of the compose mapping - which defaults to 5433, because 5432 is usually
# already taken by a native Postgres install (and that collision aborts
# `docker compose up`).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# Optional full override of the assembled DSN:
# DATABASE_URL=postgresql+psycopg://facade:facade@localhost:5433/facade

# ----------------------------------------------------------------------- Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_CONCURRENCY=2

# ------------------------------------------------------------- Garage S3 storage
# One file, two audiences, and they disagree about what "localhost" is. The value
# below is for an app started directly on the host; docker compose deliberately
# does NOT read it - the containers get their internal endpoint from
# S3_ENDPOINT_URL_INTERNAL, because http://localhost:3900 inside a container is
# the container itself. See the top of docker-compose.yml.
S3_ENDPOINT_URL=http://localhost:3900
# What the containers use to reach Garage over the compose network.
# S3_ENDPOINT_URL_INTERNAL=http://garage:3900
# Endpoint embedded in presigned URLs; must be reachable from the browser.
S3_PUBLIC_ENDPOINT_URL=http://localhost:3900
# Garage requires the access key id to be "GK" + 12 hex-encoded bytes.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_REGION=garage
S3_USE_SSL=false
S3_BUCKET_IMAGES=facade-images
S3_BUCKET_MODELS=facade-models
S3_PRESIGNED_URL_TTL_SECONDS=3600
# Browser origins allowed to read presigned objects directly from the buckets.
# Applied to both buckets at API startup (idempotently), because a presigned
# URL authorises the request but not the JavaScript: an <img> tag shows a
# cross-origin photo regardless, while the 3D viewer's fetch() of the .glb is
# readable only if the bucket itself sends Access-Control-Allow-Origin. "*" is
# the development default and stays safe - nothing is readable without a valid
# signature - but a real deployment should list its own origin(s), e.g.
# S3_CORS_ALLOWED_ORIGINS=https://facade.example.com
S3_CORS_ALLOWED_ORIGINS=*

# Garage daemon secrets (dev-only). The RPC secret must be 32 bytes, hex-encoded.
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GARAGE_VERSION=v2.0.0

# -------------------------------------------------------------- upload limits
UPLOAD_MAX_FILES_PER_REQUEST=100
UPLOAD_MAX_FILE_BYTES=26214400

# -------------------------------------------------------------------- security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------- AI inference
# Worker only. Path of the trained weights *inside* the worker container:
# docker-compose.yml bind-mounts ./code/backend at /app, so this resolves to
# code/backend/model/best.pt on the host:
#   cp yolov9c_cubit_e136_best.pt code/backend/model/best.pt
# Running the app straight on the host (uvicorn/celery from code/backend)? Use
# YOLO_MODEL_PATH=model/best.pt there instead.
YOLO_MODEL_PATH=/app/model/best.pt
# "cpu", or "cuda" to run the model on a GPU.
YOLO_DEVICE=cpu
# Inference parameters tuned experimentally on this checkpoint. Do not swap them
# for Ultralytics' defaults: conf 0.01 (not 0.25) is what keeps the
# low-confidence crack/spalling masks the results were produced with, and iou
# 0.7 is the NMS threshold the experiments used. imgsz 1280 is the input size.
YOLO_CONFIDENCE_THRESHOLD=0.01
YOLO_IOU_THRESHOLD=0.7
YOLO_IMAGE_SIZE=1280
# Restore masks to the original frame resolution (rather than the letterboxed
# inference size) so the stored/drawn polygon follows the real defect boundary.
YOLO_RETINA_MASKS=true
YOLO_MAX_DETECTIONS_PER_IMAGE=300
# When the weights are missing, fabricate plausible polygons instead of failing
# the batch, so the pipeline can be exercised end to end before best.pt exists.
# The task result and the worker log both flag this mode - never use those rows
# for an accuracy evaluation.
YOLO_ALLOW_SYNTHETIC_FALLBACK=true

# ------------------------------------------------ photogrammetry (NodeODM)
NODEODM_ENABLED=true
NODEODM_HOST=nodeodm
NODEODM_PORT=3000
# Below this many frames a reconstruction cannot work, so the step is skipped.
NODEODM_MIN_IMAGES=3
NODEODM_TASK_TIMEOUT_SECONDS=14400
# The fast/low-memory reconstruction profile. Deliberately NOT ODM's
# `fast-orthophoto`: ODM implements that by setting --skip-3dmodel, which would
# mean no textured mesh at all.
NODEODM_SKIP_ORTHOPHOTO=true
NODEODM_SKIP_REPORT=true
# `lowest` extracts too few features to match a facade (a 3-frame set fails
# outright); `medium` is the cheap tier that still reconstructs.
NODEODM_FEATURE_QUALITY=medium
NODEODM_PC_QUALITY=lowest
NODEODM_MESH_SIZE=50000
# Convert ODM's textured OBJ (+ .mtl + textures) into a single self-contained
# .glb. When the conversion is unavailable the OBJ and its sidecars are stored
# instead, so a finished reconstruction is never discarded.
NODEODM_EXPORT_GLB=true

# --------------------------------------------------- compose: seed accounts
# Used by the one-shot `bootstrap` service, which runs on every `docker compose
# up` - so both calls are idempotent (the CLI is invoked with --if-exists skip).
# Bootstrapping the first Admin cannot go through the API: /users already
# requires an Admin, and /register only ever mints Inspectors. Seeding an
# Inspector as well is what makes the whole flow usable straight after the first
# `up` - otherwise the dashboard has nobody to sign in as.
# Set an email to empty to skip that seed. These are dev-only values.
#   docker compose exec api python -m app.cli create-user \
#       --email someone@example.com --role inspector      # prompted password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin-secret-1
BOOTSTRAP_INSPECTOR_EMAIL=inspector@example.com
BOOTSTRAP_INSPECTOR_PASSWORD=inspector-secret-1

# ------------------------------------------------------ compose: the frontend
# Host port for the SPA. The Vite dev server inside the container always listens
# on 5173 - the mapping is what moves.
FRONTEND_PORT=5173
# Where the dev server proxies /api. Compose points the container at the API
# service (http://api:8000); running `npm run dev` on the host defaults to
# http://localhost:8000. Override when the API is somewhere else.
# VITE_API_PROXY_TARGET=http://api:8000
# Watch the source by polling. Required under Docker Desktop, which does not
# forward the host's filesystem events into a container, so a save on the host
# would otherwise never reach the dev server. Set to false on Linux, where bind
# mounts do deliver events - polling is a busy loop.
VITE_WATCH_POLLING=true
